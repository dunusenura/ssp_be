# ===================================================
# WorkPub Backend Environment Configuration Template
# Copy this file to '.env' before running the app:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows PowerShell)
# ===================================================

# Server Settings
PORT=5000
DEBUG=True
SECRET_KEY=your_secret_key_here

# MongoDB Database Connection
# Replace with your local MongoDB connection string or MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# OnePay Gateway Credentials (Payment Integration)
ONEPAY_APP_ID=your_onepay_app_id
ONEPAY_APP_TOKEN=your_onepay_app_token
ONEPAY_HASH_TOKEN=your_onepay_hash_token
ONEPAY_API_URL=https://api.onepay.lk/v3/checkout/link/

# WhatsApp Webhook Verification Token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
